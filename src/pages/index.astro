---
import Layout from "../layouts/Layout.astro";
import HomeV2Fr from "../components/HomeV2Fr.astro";
import { homeFaq } from "../data/home-faq";

// Le schéma FAQPage est dérivé de la même source que la section FAQ rendue :
// impossible que les deux divergent.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq.map((entry) => ({
    "@type": "Question",
    name: entry.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: entry.a,
    },
  })),
};
---

<Layout
  title="Izybiz : management de transition et IA pour vos opérations"
  description="Management de transition et intégration IA pour remettre les priorités sous contrôle, accélérer l'exécution et produire des résultats mesurables."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <HomeV2Fr />
</Layout>
