---
import Layout from "../layouts/Layout.astro";
import HomeContentFr from "../components/HomeContentFr.astro";
const lang = "fr";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qu'est-ce qu'une mission Izybiz ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Une mission Izybiz est une demande formulée en langage naturel par un dirigeant. La plateforme compose une équipe d'agents IA spécialisés pour exécuter la mission sous votre pilotage et vous restituer un livrable structuré."
      }
    },
    {
      "@type": "Question",
      "name": "Comment fonctionne la bêta privée ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'accès se fait sur invitation. Vous laissez vos coordonnées via le formulaire de la page, puis l'équipe Izybiz vous recontacte pour valider votre éligibilité et vous ouvrir l'accès."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle différence avec un assistant IA classique ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un assistant IA répond à une question à la fois. Izybiz orchestre plusieurs agents spécialisés qui se répartissent les sous-tâches d'une mission et produisent un résultat opérationnel cohérent."
      }
    },
    {
      "@type": "Question",
      "name": "Dois-je construire des workflows techniques ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Non. Izybiz est conçu pour des dirigeants qui veulent déléguer une mission sans créer de workflow complexe. Vous décrivez l'objectif et la plateforme gère l'orchestration des agents."
      }
    },
    {
      "@type": "Question",
      "name": "Est-ce que je garde le contrôle humain ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui. Izybiz est une plateforme de pilotage assisté, pas d'autonomie opaque. Vous validez les points clés et gardez la décision finale sur les actions et les livrables."
      }
    },
    {
      "@type": "Question",
      "name": "Pour quels profils d'entreprise Izybiz est conçu ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Izybiz cible les dirigeants d'ETI, de PME et de scale-ups qui veulent accélérer l'exécution de missions opérationnelles avec l'IA tout en conservant un cadre de gouvernance clair."
      }
    },
    {
      "@type": "Question",
      "name": "Quels types de missions peut-on confier à Izybiz ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La plateforme couvre des missions de cadrage, production de livrables, recherche structurée et préparation de décision. L'objectif est de passer d'une intention métier à une exécution pilotable."
      }
    }
  ]
};
---

<Layout
  lang={lang}
  title="Izybiz - Plateforme d'agents IA pour dirigeants."
  description="Izybiz, plateforme SaaS d'agents IA pour dirigeants en France. Confiez une mission, une équipe l'exécute sous votre pilotage. Accès sur invitation."
  includeGlobalScript={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <link rel="preload" as="image" href="/assets/illustration--dna.svg" />
    <link rel="preload" as="image" href="/assets/illustration--agent.svg" />
    <link rel="preload" as="image" href="/assets/illustration--output.svg" />
  </Fragment>
  <HomeContentFr />
</Layout>
