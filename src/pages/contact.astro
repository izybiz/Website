---
// Page contact — restructurée en septembre 2026 sur le modèle "deux colonnes,
// formulaire dans une carte sur fond dégradé" demandé par Lucie (référence :
// une page contact concurrente), avec nos polices/couleurs et notre contenu.
import Layout from "../layouts/Layout.astro";
import "../styles/contact.css";

const subjects = [
  "Cadrer une mission",
  "Une question",
  "Partenariat",
];
---

<Layout
  title="Contact — IZYBIZ"
  description="Écrire à IZYBIZ : parlons de votre besoin, des complexités de votre métier, et de la solution qui vous correspond. Réponse sous un jour ouvré."
  canonicalPath="/contact/"
>
  <div class="contact-v2 contact-v2--white">
    <section class="cv2-layout-section">
      <div class="cv2-layout">
        <div class="cv2-intro">
          <h1 class="cv2-title">Parlons de votre besoin.</h1>
          <p class="cv2-lede">
            Chaque métier a ses complexités. Décrivez-nous la vôtre, et
            trouvons ensemble la solution qui vous correspond.
          </p>
        </div>

        <div class="cv2-panel">
          <div class="cv2-panel__card">
            <form
              class="cv2-form"
              data-site-form
              data-form-kind="contact"
              data-form-location="contact"
              novalidate
            >
              <!-- Piège à robots : un humain ne voit pas ce champ et ne le
                   remplit donc jamais. S'il arrive rempli, Web3Forms rejette
                   l'envoi. -->
              <input
                class="cv2-botcheck"
                type="checkbox"
                name="botcheck"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />

              <div class="cv2-form__grid">
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-name">Votre nom</label>
                  <input
                    class="cv2-field"
                    id="cv2-name"
                    type="text"
                    name="nom"
                    placeholder="Votre nom"
                    autocomplete="name"
                    required
                  />
                </div>
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-company">Votre entreprise</label>
                  <input
                    class="cv2-field"
                    id="cv2-company"
                    type="text"
                    name="entreprise"
                    placeholder="Votre entreprise"
                    autocomplete="organization"
                  />
                </div>
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-email">Votre email</label>
                  <input
                    class="cv2-field"
                    id="cv2-email"
                    type="email"
                    name="email"
                    placeholder="votre@email.fr"
                    autocomplete="email"
                    required
                  />
                </div>
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-site">Votre site</label>
                  <input
                    class="cv2-field"
                    id="cv2-site"
                    type="url"
                    name="website"
                    placeholder="https://votre-site.fr"
                    autocomplete="url"
                  />
                </div>
              </div>

              <fieldset class="cv2-subjects">
                <legend class="sr-only">Votre demande</legend>
                <div class="cv2-subjects__list">
                  {
                    subjects.map((label, i) => (
                      <>
                        {/* `demande` et non `subject` : Web3Forms réserve ce
                            nom à l'objet du mail et n'afficherait pas le
                            choix. */}
                        <input
                          class="sr-only"
                          id={`cv2-subject-${i}`}
                          type="radio"
                          name="demande"
                          value={label}
                          checked={i === 0}
                        />
                        <label class="cv2-subject" for={`cv2-subject-${i}`}>
                          {label}
                        </label>
                      </>
                    ))
                  }
                </div>
              </fieldset>

              <div class="cv2-field-group">
                <label class="sr-only" for="cv2-message">Votre message</label>
                <textarea
                  class="cv2-message"
                  id="cv2-message"
                  name="message"
                  rows="5"
                  placeholder="Votre métier, votre zone d'intervention, ce que vous cherchez à obtenir…"
                ></textarea>
              </div>

              <div class="cv2-form__actions cv2-form__actions--split">
                <span class="cv2-form__note">Sans engagement · Aucune donnée revendue</span>
                <button class="cv2-submit" type="submit">Envoyer →</button>
              </div>

              <p class="cv2-form__message" role="alert" data-form-message></p>

              <p class="cv2-form__privacy">
                Vos informations ne servent qu'à traiter votre demande.
                <a href="/politique-de-confidentialite/">
                  Comment vos données sont traitées
                </a>
              </p>
            </form>
          </div>
        </div>

        <p class="cv2-side">
          Besoin d'aller plus vite ? →
          <a class="cv2-side__link" href="mailto:contact.me@izybiz.fr" data-cta="side-mailto">contact.me@izybiz.fr</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<!-- L'envoi est partagé avec les trois formulaires de la home : voir
     public/forms.js, qui distingue les deux familles par data-form-kind. -->
<script is:inline src="/forms.js" defer></script>
