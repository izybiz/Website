---
import Layout from "../../layouts/Layout.astro";
import HomeV2En from "../../components/HomeV2En.astro";
import { homeFaqEn } from "../../data/home-faq";

// Le schéma FAQPage est dérivé de la même source que la section FAQ rendue :
// impossible que les deux divergent.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqEn.map((entry) => ({
    "@type": "Question",
    name: entry.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: entry.a,
    },
  })),
};
---

<Layout
  lang="en"
  title="Izybiz: interim management and AI for your operations"
  description="Interim management and AI integration to bring priorities back under control, accelerate execution and produce measurable results."
  canonicalPath="/en/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <HomeV2En />
</Layout>
