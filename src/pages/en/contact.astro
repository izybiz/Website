---
// Page contact anglaise — traduction de src/pages/contact.astro.
import Layout from "../../layouts/Layout.astro";
import "../../styles/contact.css";

// `value` reste en français : c'est ce que Web3Forms envoie dans le champ
// « Objet de la demande » du mail. Seul `label`, affiché au visiteur, change
// de langue.
const subjects = [
  { label: "Scope a mission", value: "Cadrer une mission" },
  { label: "A question", value: "Une question" },
  { label: "Partnership", value: "Partenariat" },
];
---

<Layout
  lang="en"
  title="Contact — IZYBIZ"
  description="Write to IZYBIZ: let's talk about your need, the complexities of your trade, and the solution that fits you. Reply within one business day."
  canonicalPath="/en/contact/"
>
  <div class="contact-v2 contact-v2--white">
    <section class="cv2-layout-section">
      <div class="cv2-layout">
        <div class="cv2-intro">
          <h1 class="cv2-title">Let's talk about your need.</h1>
          <p class="cv2-lede">
            Every trade has its own complexities. Tell us about yours, and
            let's find the solution that fits you.
          </p>
        </div>

        <div class="cv2-panel">
          <div class="cv2-panel__card">
            <form
              class="cv2-form"
              data-site-form
              data-form-kind="contact"
              data-form-location="contact-en"
              novalidate
            >
              <!-- Piège à robots : un humain ne voit pas ce champ et ne le
                   remplit donc jamais. S'il arrive rempli, Web3Forms rejette
                   l'envoi. -->
              <input
                class="cv2-botcheck"
                type="checkbox"
                name="botcheck"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />

              <div class="cv2-form__grid">
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-name">Your name</label>
                  <input
                    class="cv2-field"
                    id="cv2-name"
                    type="text"
                    name="nom"
                    placeholder="Your name"
                    autocomplete="name"
                    required
                  />
                </div>
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-company">Your company</label>
                  <input
                    class="cv2-field"
                    id="cv2-company"
                    type="text"
                    name="entreprise"
                    placeholder="Your company"
                    autocomplete="organization"
                  />
                </div>
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-email">Your email</label>
                  <input
                    class="cv2-field"
                    id="cv2-email"
                    type="email"
                    name="email"
                    placeholder="you@email.com"
                    autocomplete="email"
                    required
                  />
                </div>
                <div class="cv2-field-group">
                  <label class="sr-only" for="cv2-site">Your website</label>
                  <input
                    class="cv2-field"
                    id="cv2-site"
                    type="url"
                    name="website"
                    placeholder="https://your-site.com"
                    autocomplete="url"
                  />
                </div>
              </div>

              <fieldset class="cv2-subjects">
                <legend class="sr-only">Your request</legend>
                <div class="cv2-subjects__list">
                  {
                    subjects.map((s, i) => (
                      <>
                        {/* `demande` et non `subject` : Web3Forms réserve ce
                            nom à l'objet du mail et n'afficherait pas le
                            choix. */}
                        <input
                          class="sr-only"
                          id={`cv2-subject-${i}`}
                          type="radio"
                          name="demande"
                          value={s.value}
                          checked={i === 0}
                        />
                        <label class="cv2-subject" for={`cv2-subject-${i}`}>
                          {s.label}
                        </label>
                      </>
                    ))
                  }
                </div>
              </fieldset>

              <div class="cv2-field-group">
                <label class="sr-only" for="cv2-message">Your message</label>
                <textarea
                  class="cv2-message"
                  id="cv2-message"
                  name="message"
                  rows="5"
                  placeholder="Your trade, your service area, what you're looking to get…"
                ></textarea>
              </div>

              <div class="cv2-form__actions cv2-form__actions--split">
                <span class="cv2-form__note">No commitment · No data resold</span>
                <button class="cv2-submit" type="submit">Send →</button>
              </div>

              <p class="cv2-form__message" role="alert" data-form-message></p>

              <p class="cv2-form__privacy">
                Your information is only used to handle your request.
                <a href="/en/privacy-policy/">
                  How your data is handled
                </a>
              </p>
            </form>
          </div>
        </div>

        <p class="cv2-side">
          Need to move faster? →
          <a class="cv2-side__link" href="mailto:contact.me@izybiz.fr">contact.me@izybiz.fr</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<!-- L'envoi est partagé avec les trois formulaires de la home : voir
     public/forms.js, qui distingue les deux familles par data-form-kind. -->
<script is:inline src="/forms.js" defer></script>
