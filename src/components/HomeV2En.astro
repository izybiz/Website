---
// Home EN v2 — miroir de HomeV2Fr.astro (voir ce fichier pour le contexte
// des sections), simplement traduit. Les deux composants doivent rester
// structurellement alignés : toute section ajoutée/retirée côté FR doit
// être répercutée ici.
import "../styles/home-v2.css";
import { getCollection } from "astro:content";
import { homeFaqEn as faq } from "../data/home-faq";

const latestPosts = (await getCollection("blog-en"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const caseStudies = [
  {
    color: "yellow",
    label: "Delivered",
    title: "Telecom & Fintech · Africa",
    description:
      "A telecom operator needed to launch a super-app in two markets at once: two distinct operational scenarios, numerous stakeholders and divestment pressure. We defined and built the product, structured two separate go-to-market scenarios — the client chose one and deployed it.",
  },
  {
    color: "blue",
    label: "Delivered",
    title: "Community marketplace · Africa",
    description:
      "An e-commerce marketplace needed to go from zero to a viable market in under two years: positioning, brand, organisation, go-to-market and building an active community of buyers and sellers. We structured and drove end-to-end delivery up to €1.25M GMV in 18 months.",
  },
  {
    color: "orange",
    label: "In progress",
    title: "Community kitchen · Europe",
    description:
      "A cooking enthusiast wanted to turn daily meal prep into a lever for social connection and savings. We structured an operational \"home collective kitchen\" model and designed the product experience through a mobile app that orchestrates batch-cooking sessions around a triple gain: 50% savings, time saved, and wellbeing.",
  },
  {
    color: "lavender",
    label: "Starting up",
    title: "Agentic delivery · France",
    description:
      "A French software publisher needed to make client deployments reliable without growing headcount. We're designing a system of autonomous AI agents supervised by humans to orchestrate and deliver client projects — from onboarding to production.",
  },
];
---

<div class="home-v2">
  {/* ================= S2 — Hero ================= */}
  <section aria-labelledby="hv2-hero-title" data-section="hero">
    <div class="hv2-hero__head hv2-wrap--narrow" style="margin:0 auto">
      <h1 class="hv2-hero__title" id="hv2-hero-title">
        Interim management and AI for your operations
      </h1>
      <p class="hv2-hero__sub">
        Interim management and AI integration to bring priorities back under
        control, accelerate execution and produce measurable results.
      </p>
      <div class="hv2-hero__actions">
        <a class="hv2-hero__button" href="/en/contact/" data-cta="hero">Get in touch</a>
        <a
          class="hv2-hero__button hv2-hero__button--secondary"
          href="https://www.linkedin.com/company/izybiz/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open IZYBIZ's LinkedIn page in a new tab"
        >
          Send a LinkedIn message
        </a>
      </div>
    </div>

    <div class="hv2-hero__metrics">
      <div class="hv2-hero__metrics-item">
        <p class="hv2-hero__metrics-title">95%</p>
        <p class="hv2-hero__metrics-desc">
          Failure rate of generative AI projects in business.
        </p>
      </div>
      <div class="hv2-hero__metrics-item">
        <p class="hv2-hero__metrics-title">23%</p>
        <p class="hv2-hero__metrics-desc">
          Only 23% of executives can connect their AI investments to a
          measurable financial outcome.
        </p>
      </div>
      <div class="hv2-hero__metrics-item">
        <p class="hv2-hero__metrics-title">84%</p>
        <p class="hv2-hero__metrics-desc">
          84% of AI failures are due to poor management, not the technology
          itself.
        </p>
      </div>
    </div>
  </section>

  {/* ================= S4b — AI integration ================= */}
  <section class="hv2-ai" aria-labelledby="hv2-ai-title">
    <div class="hv2-wrap hv2-ai__inner">
      <div class="hv2-ai__head">
        <h2 class="hv2-ai__title" id="hv2-ai-title">
          Integrating AI without losing operational control
        </h2>
        <p class="hv2-ai__sub">
          AI creates value when it fits into clear priorities, processes that
          hold, and explicit responsibilities.
        </p>
        <a class="hv2-ai__more" href="/en/ai-integration/">
          Our approach to AI integration in business
        </a>
      </div>

      <div class="hv2-ai__video">
        <video class="hv2-ai__video-media" controls preload="metadata">
          <source src="/assets/Anim-Izybiz-V2.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </section>

  {/* ================= S2b — Interim management ================= */}
  <section class="hv2-transition" aria-labelledby="hv2-transition-title">
    <div class="hv2-wrap hv2-transition__inner">
      <div class="hv2-transition__head">
        <h2 class="hv2-transition__title" id="hv2-transition-title">
          Interim management <br />
          for critical phases
        </h2>
        <p class="hv2-transition__sub">
          When an activity is drifting, a strategic project is slowing down, or
          a transformation needs to deliver fast, a scoping deck isn't enough.
          You need operational leadership able to take charge, set priorities
          and hold execution.
        </p>
        <a class="hv2-transition__more" href="/en/interim-management/">
          Our approach to interim management
        </a>
      </div>

      <ul class="blog-list hv2-transition__posts" aria-label="Latest articles">
        {
          latestPosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const date = post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
            return (
              <li class="blog-card">
                <a class="blog-card__link" href={`/en/blog/${slug}/`}>
                  <time class="blog-card__date" datetime={post.data.pubDate.toISOString()}>
                    {date}
                  </time>
                  <div class="blog-card__content">
                    <h3 class="blog-card__title">{post.data.title}</h3>
                    <p class="blog-card__description">{post.data.description}</p>
                  </div>
                  <span class="blog-card__cta">Read the article</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {/* ================= S5 — What we deliver (we-deliver) ================= */}
  <section class="we-deliver" aria-labelledby="we-deliver-title">
    <div class="we-deliver__intro">
      <h2 class="we-deliver__title" id="we-deliver-title">
        Measurable results, not textbook recommendations
      </h2>
      <p class="we-deliver__intro-copy">
        A useful mission is judged by what it changes in operations, not by
        the quality of the slides. From day one, we clarify objectives, the
        indicators to track and the priorities to work on. The goal is
        simple: produce effects that are visible, legible and measurable.
      </p>
    </div>

    <div class="we-deliver__cards-row">
      <article class="we-deliver__card we-deliver__card--dna">
        <div class="we-deliver__card-content we-deliver__card-content--dna">
          <h3 class="we-deliver__card-title">WHAT YOU BRING</h3>
          <div class="we-deliver__card-tabs">
            <span class="we-deliver__card-tab">Business objectives</span>
            <span class="we-deliver__card-tab">Key processes</span>
            <span class="we-deliver__card-tab">Constraints</span>
            <span class="we-deliver__card-tab">Requirements</span>
            <span class="we-deliver__card-tab">Internal teams</span>
            <span class="we-deliver__card-tab">Existing tools</span>
          </div>
        </div>
        <div class="we-deliver__card-illustration we-deliver__card-illustration--dna" aria-hidden="true">
          <img class="we-deliver__illustration-image" src="/assets/illustration--dna.svg" alt="" />
        </div>
      </article>

      <article class="we-deliver__card we-deliver__card--agent">
        <div class="we-deliver__card-content we-deliver__card-content--agent">
          <h3 class="we-deliver__card-title">WHAT WE STRUCTURE</h3>
          <div class="we-deliver__card-tabs">
            <span class="we-deliver__card-tab">Use-case framing</span>
            <span class="we-deliver__card-tab">Vendor selection</span>
            <span class="we-deliver__card-tab">Technology choice</span>
            <span class="we-deliver__card-tab">AI workflow</span>
            <span class="we-deliver__card-tab">Human checkpoints</span>
          </div>
        </div>
        <div class="we-deliver__card-illustration we-deliver__card-illustration--agent" aria-hidden="true">
          <img class="we-deliver__illustration-image" src="/assets/illustration--agent.svg" alt="" />
        </div>
      </article>

      <article class="we-deliver__card we-deliver__card--output">
        <div class="we-deliver__card-content we-deliver__card-content--output">
          <h3 class="we-deliver__card-title">WHAT YOU OWN</h3>
          <div class="we-deliver__card-tabs">
            <span class="we-deliver__card-tab">Operational AI system</span>
            <span class="we-deliver__card-tab">Documented workflows</span>
            <span class="we-deliver__card-tab">Trained team</span>
            <span class="we-deliver__card-tab">Clear responsibilities</span>
            <span class="we-deliver__card-tab">Full autonomy</span>
          </div>
        </div>
        <div class="we-deliver__card-illustration we-deliver__card-illustration--output" aria-hidden="true">
          <img class="we-deliver__illustration-image" src="/assets/illustration--output.svg" alt="" />
        </div>
      </article>
    </div>

    <p class="we-deliver__swipe-hint" aria-hidden="true">Swipe to see more →</p>

    <div class="we-deliver__services-link">
      <a href="/en/services/">See all our missions</a>
    </div>
  </section>

  {/* ================= S4c — Our latest missions (section-two) ================= */}
  <section class="section-two" aria-labelledby="section-two-title">
    <div class="hv2-wrap section-two__inner">
      <header class="section-two__intro">
        <h2 class="section-two__title" id="section-two-title">Our latest missions</h2>
        <div class="section-two__topbar">
          <div class="section-two__tabs" role="tablist" aria-label="Case studies" data-case-tablist>
            {
              caseStudies.map((c, i) => (
                <button
                  class={`section-two__tab${i === 0 ? " is-active" : ""}`}
                  type="button"
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-case-tab
                >
                  {c.title}
                </button>
              ))
            }
          </div>
          <div class="section-two__mobile-nav">
            <span class="section-two__counter" data-case-counter>1/{caseStudies.length}</span>
            <div class="section-two__controls">
              <button class="section-two__arrow section-two__arrow--prev" type="button" data-case-prev aria-label="Previous case" disabled>
                <span aria-hidden="true">←</span>
              </button>
              <button class="section-two__arrow section-two__arrow--next" type="button" data-case-next aria-label="Next case">
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <div class="section-two__grid" data-case-grid>
        {
          caseStudies.map((c, i) => (
            <article
              class={`section-two__case section-two__case--${c.color}${i === 0 ? " is-active" : ""}`}
              tabindex="0"
            >
              <div class="section-two__case-copy">
                <span class="section-two__case-label">{c.label}</span>
                <h3 class="section-two__case-title">{c.title}</h3>
                <p class="section-two__case-description">{c.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= S10 — FAQ ================= */}
  <section class="hv2-faq" aria-labelledby="hv2-faq-title" data-section="faq">
    <div class="hv2-wrap hv2-faq__inner">
      <span class="hv2-faq__badge">FAQ</span>
      <h2 class="hv2-faq__title" id="hv2-faq-title">Questions we get asked</h2>
      <div class="hv2-faq__list">
        {
          faq.map((f) => (
            <details class="hv2-faq__item">
              <summary class="hv2-faq__q">
                <span class="hv2-faq__q-text">{f.q}</span>
                <span class="hv2-faq__chevron" aria-hidden="true">
                  ▾
                </span>
              </summary>
              <p class="hv2-faq__a">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= S11 — Final CTA ================= */}
  <section aria-labelledby="hv2-final-title" data-section="final">
    <div class="hv2-wrap hv2-final__inner">
      <div class="hv2-final__grid">
        <h2 class="hv2-final__title" id="hv2-final-title">
          Tell us what you need,<br class="hv2-final__title-break" /> we'll take it from there.
        </h2>
        <div>
          <a class="hv2-btn hv2-final__cta" href="/en/contact/" data-cta="final-cta">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline src="/forms.js" defer></script>
<script is:inline src="/home-v2.js" defer></script>
