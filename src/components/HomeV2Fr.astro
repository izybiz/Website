---
// Home FR v2 — portage de la maquette Claude Design (août 2026).
// Les données de la maquette (listes, FAQ, roster…) sont rendues côté serveur :
// pas de framework client, seul home-v2.js gère onglets + frise animée.
import "../styles/home-v2.css";
import { getCollection } from "astro:content";
import { homeFaq as faq } from "../data/home-faq";

const latestPosts = (await getCollection("blog-fr"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroSteps = [
  "Lire votre site pour comprendre votre métier",
  "Chercher qui les IA citent sur vos sujets",
  "Chercher une entreprise comparable à la vôtre",
  "Mesurer si les IA vous citent",
  "Examiner votre référencement",
  "Examiner le site le plus cité",
  "Examiner le site comparable",
  "Rassembler le tout dans votre rapport",
].map((label, i) => ({
  label,
  mark: i < 6 ? "✓" : "",
  delay: `${(2.4 + i * 0.55).toFixed(2)}s`,
}));


const tabs = [
  { id: "attirer", label: "Attirer" },
  { id: "convertir", label: "Convertir" },
  { id: "vendre", label: "Vendre" },
];

const missions = {
  attirer: [
    { mark: "✓", label: "Audite votre site" },
    { mark: "✓", label: "Corrige votre site" },
    { mark: "✓", label: "Fait une veille de marché" },
    { mark: "✓", label: "Construit une stratégie éditoriale" },
    { mark: "✓", label: "Créé un calendrier éditorial" },
    { mark: "", label: "Surveille vos concurrents et votre secteur" },
    { mark: "", label: "Rédige vos supports" },
    { mark: "", label: "Remesure votre visibilité" },
  ],
  convertir: [
    { mark: "✓", label: "Met en avant vos références sur le site" },
    { mark: "✓", label: "Installe la demande de devis en un clic" },
    { mark: "", label: "Reçoit chaque demande entrante" },
    { mark: "", label: "Transmet le contexte du visiteur" },
  ],
  vendre: [
    { mark: "✓", label: "Tient le registre de vos devis" },
    { mark: "✓", label: "Repère quand le prospect revient" },
    { mark: "", label: "Prépare la relance avec du neuf" },
    { mark: "", label: "Réveille les devis dormants" },
    { mark: "", label: "Suit vos signatures chaque mois" },
  ],
};

// Onglet « Attirer » — conversation pilotée par les données
const chatAttirer = {
  izy: "Le bilan du mois est prêt. Deux textes attendent votre validation.",
  you: "Montre-moi l'article.",
  tag: "À VALIDER",
  meta: "article · 1 240 mots",
  title:
    "Remplacer une chaudière en 2026 : ce qui change pour les locaux professionnels",
  sub: "Recherche visée : remplacement chaudière local professionnel",
  cta: "Valider",
  alt: "Demander une correction",
};

const quotes = [
  {
    name: "Olivier",
    role: "Président, Kirei SA",
    src: "/assets/temoin-olivier.jpg",
    text: "Izy a transformé notre visibilité digitale. On signe enfin des devis via le web.",
  },
  {
    name: "Pascal",
    role: "DG, Clean Power",
    src: "/assets/temoin-pascal.jpg",
    text: "Le vrai plus ? Ne pas recruter. Izy livre, je valide, et les résultats tombent.",
  },
  {
    name: "Ophélie",
    role: "Freelance SEO, Mood.be",
    src: "/assets/temoin-ophelie.jpg",
    text: "En tant qu'experte SEO, j'ai été bluffée par la pertinence des contenus générés par Izy",
  },
];

const caseStudies = [
  {
    color: "yellow",
    label: "Livré",
    title: "Telecom & Fintech · Afrique",
    description:
      "Un opérateur telecom devait lancer une super-app sur deux marchés en même temps : deux scénarios opérationnels distincts, de nombreuses parties prenantes et pression de cession. Nous avons défini et construit le produit, structuré deux scénarios de go-to-market distincts — le client en a choisi un et l'a déployé.",
  },
  {
    color: "blue",
    label: "Livré",
    title: "Marketplace communautaire · Afrique",
    description:
      "Une marketplace e-commerce devait passer de zéro à un marché viable en moins de deux ans : positionnement, marque, organisation, go-to-market et construction d'une communauté active d'acheteurs et de vendeurs. Nous avons structuré et piloté la livraison de bout en bout jusqu'à 1,25 M€ de GMV en 18 mois.",
  },
  {
    color: "orange",
    label: "En cours",
    title: "Cuisine communautaire · Europe",
    description:
      "Une passionnée de cuisine voulait faire de la préparation quotidienne des repas un levier de lien social et d'économies. Nous avons structuré un modèle opérationnel de « cuisine collective à domicile » et conçu l'expérience produit via une application mobile qui orchestre des sessions de batch cooking autour d'un triple gain : 50 % d'économies, gain de temps et bien-être.",
  },
  {
    color: "lavender",
    label: "Démarrage",
    title: "Delivery agentique · France",
    description:
      "Un éditeur logiciel français devait fiabiliser les déploiements clients sans augmenter les effectifs. Nous concevons un système d'agents IA autonomes supervisés par l'humain pour orchestrer et livrer les projets clients — de l'onboarding à la mise en production.",
  },
];

---

<div class="home-v2">
  {/* ================= S2 — Hero ================= */}
  <section aria-labelledby="hv2-hero-title" data-section="hero">
    <div class="hv2-hero__head hv2-wrap--narrow" style="margin:0 auto">
      <h1 class="hv2-hero__title" id="hv2-hero-title">
        Management de transition et IA pour vos opérations
      </h1>
      <p class="hv2-hero__sub">
        Management de transition et intégration IA pour remettre les priorités sous
        contrôle, accélérer l'exécution et produire des résultats mesurables.
      </p>
      <div class="hv2-hero__actions">
        <a class="hv2-hero__button" href="/contact/" data-cta="hero">Prendre contact</a>
        <a
          class="hv2-hero__button hv2-hero__button--secondary"
          href="https://www.linkedin.com/company/izybiz/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ouvrir la page LinkedIn d'IZYBIZ dans un nouvel onglet"
        >
          Envoyer un message LinkedIn
        </a>
      </div>
    </div>

    <div class="hv2-hero__metrics">
      <div class="hv2-hero__metrics-item">
        <p class="hv2-hero__metrics-title">95%</p>
        <p class="hv2-hero__metrics-desc">
          Taux d'échec des projets d'IA générative en entreprise.
        </p>
      </div>
      <div class="hv2-hero__metrics-item">
        <p class="hv2-hero__metrics-title">23%</p>
        <p class="hv2-hero__metrics-desc">
          Seulement 23 % des dirigeants peuvent relier leurs investissements IA à un
          résultat financier mesurable.
        </p>
      </div>
      <div class="hv2-hero__metrics-item">
        <p class="hv2-hero__metrics-title">84%</p>
        <p class="hv2-hero__metrics-desc">
          84 % des échecs d'IA sont dus à une mauvaise gestion, pas à la technologie
          en elle-même.
        </p>
      </div>
    </div>
  </section>

  {/* ================= S4b — Intégrer l'IA ================= */}
  <section class="hv2-ai" aria-labelledby="hv2-ai-title">
    <div class="hv2-wrap hv2-ai__inner">
      <div class="hv2-ai__head">
        <h2 class="hv2-ai__title" id="hv2-ai-title">
          Intégrer l'IA sans perdre le contrôle opérationnel
        </h2>
        <p class="hv2-ai__sub">
          L'IA crée de la valeur lorsqu'elle s'inscrit dans des priorités claires, des
          processus tenus et des responsabilités explicites.
        </p>
        <a class="hv2-ai__more" href="/integration-ia/">
          Notre approche intégration IA en entreprise
        </a>
      </div>

      <div class="hv2-ai__video">
        <video class="hv2-ai__video-media" controls preload="metadata">
          <source src="/assets/Anim-Izybiz-V2.mp4" type="video/mp4" />
          Votre navigateur ne prend pas en charge la balise vidéo.
        </video>
      </div>
    </div>
  </section>

  {/* ================= S2b — Management de transition ================= */}
  <section class="hv2-transition" aria-labelledby="hv2-transition-title">
    <div class="hv2-wrap hv2-transition__inner">
      <div class="hv2-transition__head">
        <h2 class="hv2-transition__title" id="hv2-transition-title">
          Management de transition <br />
          pour les phases critiques
        </h2>
        <p class="hv2-transition__sub">
          Quand une activité dérive, qu'un projet stratégique ralentit ou qu'une
          transformation doit produire vite, il faut plus qu'un cadrage. Il faut une
          direction opérationnelle capable de reprendre la main, fixer les priorités
          et tenir l'exécution.
        </p>
        <a class="hv2-transition__more" href="/management-de-transition/">
          Notre approche management de transition
        </a>
      </div>

      <ul class="blog-list hv2-transition__posts" aria-label="Derniers articles">
        {
          latestPosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const date = post.data.pubDate.toLocaleDateString("fr-FR", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
            return (
              <li class="blog-card">
                <a class="blog-card__link" href={`/blog/${slug}/`}>
                  <time class="blog-card__date" datetime={post.data.pubDate.toISOString()}>
                    {date}
                  </time>
                  <div class="blog-card__content">
                    <h3 class="blog-card__title">{post.data.title}</h3>
                    <p class="blog-card__description">{post.data.description}</p>
                  </div>
                  <span class="blog-card__cta">Lire l'article</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {/* ================= S5 — Ce qu'on délivre (we-deliver) ================= */}
  <section class="we-deliver" aria-labelledby="we-deliver-title">
    <div class="we-deliver__intro">
      <h2 class="we-deliver__title" id="we-deliver-title">
        Des résultats mesurables, pas des recommandations de principe
      </h2>
      <p class="we-deliver__intro-copy">
        Une mission utile se juge sur ce qu'elle change dans les opérations, pas sur
        la qualité des slides. Dès le démarrage, nous clarifions les objectifs, les
        indicateurs à suivre et les chantiers à prioriser. L'enjeu est simple :
        produire des effets visibles, lisibles et mesurables.
      </p>
    </div>

    <div class="we-deliver__cards-row">
      <article class="we-deliver__card we-deliver__card--dna">
        <div class="we-deliver__card-content we-deliver__card-content--dna">
          <h3 class="we-deliver__card-title">CE QUE VOUS APPORTEZ</h3>
          <div class="we-deliver__card-tabs">
            <span class="we-deliver__card-tab">Objectifs business</span>
            <span class="we-deliver__card-tab">Processus clés</span>
            <span class="we-deliver__card-tab">Contraintes</span>
            <span class="we-deliver__card-tab">Exigences</span>
            <span class="we-deliver__card-tab">Équipes internes</span>
            <span class="we-deliver__card-tab">Outils existants</span>
          </div>
        </div>
        <div class="we-deliver__card-illustration we-deliver__card-illustration--dna" aria-hidden="true">
          <img class="we-deliver__illustration-image" src="/assets/illustration--dna.svg" alt="" />
        </div>
      </article>

      <article class="we-deliver__card we-deliver__card--agent">
        <div class="we-deliver__card-content we-deliver__card-content--agent">
          <h3 class="we-deliver__card-title">CE QUE NOUS STRUCTURONS</h3>
          <div class="we-deliver__card-tabs">
            <span class="we-deliver__card-tab">Cadrage des cas d'usage</span>
            <span class="we-deliver__card-tab">Sélection des fournisseurs</span>
            <span class="we-deliver__card-tab">Choix technologique</span>
            <span class="we-deliver__card-tab">Workflow IA</span>
            <span class="we-deliver__card-tab">Points de contrôle humains</span>
          </div>
        </div>
        <div class="we-deliver__card-illustration we-deliver__card-illustration--agent" aria-hidden="true">
          <img class="we-deliver__illustration-image" src="/assets/illustration--agent.svg" alt="" />
        </div>
      </article>

      <article class="we-deliver__card we-deliver__card--output">
        <div class="we-deliver__card-content we-deliver__card-content--output">
          <h3 class="we-deliver__card-title">CE QUE VOUS POSSÉDEZ</h3>
          <div class="we-deliver__card-tabs">
            <span class="we-deliver__card-tab">Système IA opérationnel</span>
            <span class="we-deliver__card-tab">Workflows documentés</span>
            <span class="we-deliver__card-tab">Équipe formée</span>
            <span class="we-deliver__card-tab">Responsabilités claires</span>
            <span class="we-deliver__card-tab">Autonomie complète</span>
          </div>
        </div>
        <div class="we-deliver__card-illustration we-deliver__card-illustration--output" aria-hidden="true">
          <img class="we-deliver__illustration-image" src="/assets/illustration--output.svg" alt="" />
        </div>
      </article>
    </div>

    <p class="we-deliver__swipe-hint" aria-hidden="true">Faites glisser →</p>

    <div class="we-deliver__services-link">
      <a href="/services/">Voir toutes nos missions</a>
    </div>
  </section>


  {/* ================= S4b2 — Témoignages (masqué temporairement, à réafficher plus tard) ================= */}
  <section class="hv2-quotes" aria-labelledby="hv2-quotes-title" data-section="quotes" style="display:none;">
    <div class="hv2-wrap hv2-quotes__inner">
      <h2 class="hv2-quotes__title" id="hv2-quotes-title">
        Ce que nos clients disent de l'expérience Izy
      </h2>
      <div class="hv2-quotes__grid">
        {
          quotes.map((q) => (
            <figure class="hv2-quote">
              <img
                class="hv2-quote__photo"
                src={q.src}
                alt={q.name}
                width="192"
                height="192"
                loading="lazy"
                decoding="async"
              />
              <blockquote class="hv2-quote__text">« {q.text} »</blockquote>
              <figcaption class="hv2-quote__caption">
                <span class="hv2-quote__name">{q.name}</span>
                <span class="hv2-quote__role">{q.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= S4c — Nos dernières missions (section-two) ================= */}
  <section class="section-two" aria-labelledby="section-two-title">
    <div class="hv2-wrap section-two__inner">
      <header class="section-two__intro">
        <h2 class="section-two__title" id="section-two-title">Nos dernières missions</h2>
        <div class="section-two__topbar">
          <div class="section-two__tabs" role="tablist" aria-label="Études de cas" data-case-tablist>
            {
              caseStudies.map((c, i) => (
                <button
                  class={`section-two__tab${i === 0 ? " is-active" : ""}`}
                  type="button"
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-case-tab
                >
                  {c.title}
                </button>
              ))
            }
          </div>
          <div class="section-two__mobile-nav">
            <span class="section-two__counter" data-case-counter>1/{caseStudies.length}</span>
            <div class="section-two__controls">
              <button class="section-two__arrow section-two__arrow--prev" type="button" data-case-prev aria-label="Cas précédent" disabled>
                <span aria-hidden="true">←</span>
              </button>
              <button class="section-two__arrow section-two__arrow--next" type="button" data-case-next aria-label="Cas suivant">
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <div class="section-two__grid" data-case-grid>
        {
          caseStudies.map((c, i) => (
            <article
              class={`section-two__case section-two__case--${c.color}${i === 0 ? " is-active" : ""}`}
              tabindex="0"
            >
              <div class="section-two__case-copy">
                <span class="section-two__case-label">{c.label}</span>
                <h3 class="section-two__case-title">{c.title}</h3>
                <p class="section-two__case-description">{c.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= S10 — FAQ ================= */}
  <section class="hv2-faq" aria-labelledby="hv2-faq-title" data-section="faq">
    <div class="hv2-wrap hv2-faq__inner">
      <span class="hv2-faq__badge">FAQ</span>
      <h2 class="hv2-faq__title" id="hv2-faq-title">Les questions qu'on nous pose</h2>
      <div class="hv2-faq__list">
        {
          faq.map((f) => (
            <details class="hv2-faq__item">
              <summary class="hv2-faq__q">
                <span class="hv2-faq__q-text">{f.q}</span>
                <span class="hv2-faq__chevron" aria-hidden="true">
                  ▾
                </span>
              </summary>
              <p class="hv2-faq__a">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= S11 — CTA final ================= */}
  <section aria-labelledby="hv2-final-title" data-section="final">
    <div class="hv2-wrap hv2-final__inner">
      <div class="hv2-final__grid">
        <h2 class="hv2-final__title" id="hv2-final-title">
          Parlez-nous de votre besoin,<br class="hv2-final__title-break" /> on s'occupe du reste.
        </h2>
        <div>
          <a class="hv2-btn hv2-final__cta" href="/contact/" data-cta="final-cta">Nous contacter</a>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline src="/forms.js" defer></script>
<script is:inline src="/home-v2.js" defer></script>
