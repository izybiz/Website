---
import "../styles/global.css";
import "../styles/site-chrome.css";
import {
  defaultLang,
  getLocalizedPath,
  mapPathToLang,
  type Lang,
  useTranslations,
} from "../i18n/translations";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalPath?: string;
  includeGlobalScript?: boolean;
  ogType?: string;
  ogImage?: string;
  pubDate?: string;
  navType?: "home" | "page";
  alternates?: { fr?: string; en?: string; es?: string };
  noindex?: boolean;
}

const frontmatter = (Astro.props as { frontmatter?: Partial<Props> }).frontmatter ?? {};

const {
  title = frontmatter.title ?? "Izybiz",
  description = frontmatter.description ?? "",
  lang: langProp = frontmatter.lang ?? defaultLang,
  canonicalPath = frontmatter.canonicalPath ?? Astro.url.pathname,
  includeGlobalScript = frontmatter.includeGlobalScript ?? false,
  ogType = frontmatter.ogType ?? "website",
  ogImage = frontmatter.ogImage ?? "https://izybiz.fr/assets/og-default.jpg",
  pubDate = frontmatter.pubDate,
  navType: navTypeProp = frontmatter.navType,
  alternates = frontmatter.alternates,
  noindex = frontmatter.noindex ?? false,
} = Astro.props as Partial<Props>;

const lang = langProp as Lang;

const t = useTranslations(lang);
const cleanPath = canonicalPath.endsWith("/") ? canonicalPath.slice(0, -1) || "/" : canonicalPath;
// Auto-detect nav type
const homePathnames = new Set(["/"]);
const navType = navTypeProp ?? (homePathnames.has(Astro.url.pathname) ? "home" : "page");
const isBlogArticlePage = /^\/blog\/[^/]+\/?$/.test(Astro.url.pathname);
const rawPath = canonicalPath || "/";
const canonicalUrl = `https://izybiz.fr${rawPath.endsWith("/") ? rawPath : rawPath + "/"}`;
// La home v2 remplace la section #prendre-contact par le formulaire de
// diagnostic : le CTA du header pointe dessus, depuis n'importe quelle page.
const diagnosticHref = `${getLocalizedPath("home", lang)}#diagnostic`;
// La page /contact/ n'existe qu'en FR : les pages EN et ES (le blog) renvoient
// au formulaire de diagnostic de leur home, faute de mieux.
const contactHref = lang === "fr" ? "/contact/" : diagnosticHref;
const localizedAlt = {
  fr: alternates?.fr ?? mapPathToLang(cleanPath, "fr"),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TS3MZTN79V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // Consent Mode v2: deny by default before analytics storage is granted.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        wait_for_update: 500
      });
      // Restore previous consent if user already chose.
      try {
        if (localStorage.getItem('cookie_consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
      gtag('config', 'G-TS3MZTN79V');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="icon" href="/assets/fav-icon.png" type="image/png" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={`https://izybiz.fr${localizedAlt.fr}`} />
    <link rel="alternate" hreflang="x-default" href={`https://izybiz.fr${localizedAlt.fr}`} />

    <!-- Structured data: Organization + SoftwareApplication (all pages) -->
  <script type="application/ld+json" set:html={JSON.stringify({                       
    "@context": "https://schema.org",                          
    "@graph": [                                                                       
      {        
        "@type": "Organization",                                                      
        "@id": "https://izybiz.fr/#organization",
        "name": "Izybiz",                        
        "url": "https://izybiz.fr/",                                                  
        "logo": {                   
          "@type": "ImageObject",                                                     
          "url": "https://izybiz.fr/assets/Logo%20Izybiz.png"
        },                                                                            
        "description": "Izybiz, plateforme SaaS d'agents IA pour managers en France. Confiez une mission, une équipe l'exécute sous votre pilotage. Accès sur invitation.",   
        "email": "contact.me@izybiz.fr",                                                    
        "foundingDate": "2025",   
        "areaServed": {                                                               
          "@type": "Country",                                                         
          "name": "France"   
        },                                                                            
        "sameAs": [
          "https://www.linkedin.com/company/izybiz/"
        ],                                          
        "contactPoint": {                                                             
          "@type": "ContactPoint",
          "contactType": "sales",                                                     
          "url": "https://www.linkedin.com/company/izybiz/",
          "availableLanguage": ["French", "English", "Spanish"]
        }                                                                             
      }, 
      {                                                                               
        "@type": "SoftwareApplication",
        "@id": "https://izybiz.fr/#software",
        "name": "Izybiz",                    
        "applicationCategory": "BusinessApplication",                                 
        "operatingSystem": "Web",                    
        "url": "https://izybiz.fr/",                                                  
        "description": "Plateforme SaaS d'agents IA pour déléguer des missions opérationnelles. Destinée aux managers de PME et ETI français.",                  
        "offers": {                                                                   
          "@type": "Offer",
          "priceCurrency": "EUR",                                                     
          "availability": "https://schema.org/InvitationOnly"
        },                                                   
        "provider": {                                                                 
          "@id": "https://izybiz.fr/#organization"
        }                                                                             
      }                                                                               
    ]
  })} />                                                                              

    {ogType === "article" && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "url": canonicalUrl,
        ...(pubDate && { "datePublished": pubDate, "dateModified": pubDate }),
        "image": ogImage,
        "author": {
          "@type": "Person",
          "name": "Stéphane Dine",
          "url": "https://www.linkedin.com/company/izybiz/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Izybiz",
          "logo": {
            "@type": "ImageObject",
            "url": "https://izybiz.fr/assets/Logo%20Izybiz.png"
          }
        }
      })} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:site_name" content="Izybiz" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body id="top" class:list={[isBlogArticlePage && "page-blog-article"]}>
    <script>document.body.classList.add('intro-stage-1')</script>
    <header class="site-chrome" aria-label="Site header">
      <div class="site-chrome__inner">
        <a class="site-chrome__brand" href={getLocalizedPath("home", lang)} aria-label="Accueil Izybiz">
          <img
            class="site-chrome__logo"
            src="/assets/logo-izybiz.svg"
            alt="IZYBIZ"
            width="710"
            height="198"
            fetchpriority="high"
          />
        </a>
        <div class="site-chrome__spacer"></div>

        <nav class="site-chrome__nav" aria-label="Primary">
          <a class="site-chrome__link" href={getLocalizedPath("blog", lang)}>{t("nav.blog")}</a>
          {/* Sans destination tant que l'app n'a pas d'URL publique — rendu en
              <span> pour éviter un lien mort qui renverrait en haut de page. */}
          <span class="site-chrome__link site-chrome__link--inactive">Connexion</span>
          <a class="site-chrome__cta" href={diagnosticHref} data-cta="hero">Analyser mon site</a>
        </nav>

        <button
          class="site-chrome__toggle"
          type="button"
          aria-label="Ouvrir le menu"
          aria-controls="site-chrome-menu"
          aria-expanded="false"
          data-chrome-toggle
        >
          <span class="site-chrome__toggle-bar" aria-hidden="true"></span>
        </button>
      </div>

      <div class="site-chrome__menu" id="site-chrome-menu" hidden data-chrome-menu>
        <a class="site-chrome__menu-link" href={getLocalizedPath("blog", lang)}>{t("nav.blog")}</a>
        <span class="site-chrome__menu-link site-chrome__link--inactive">Connexion</span>
      </div>
    </header>
    <div class="layout-content-slot">
      <slot />
    </div>
    <footer class="site-chrome-footer" aria-label="Footer" data-section="footer">
      <div class="site-chrome-footer__inner">
        <a href={getLocalizedPath("home", lang)} aria-label="Accueil Izybiz">
          <img
            class="site-chrome-footer__logo"
            src="/assets/logo-izybiz.svg"
            alt="IZYBIZ"
            width="710"
            height="198"
          />
        </a>
        {lang === "fr" && (
          <a class="site-chrome-footer__link" href="/mentions-legales/">{t("footer.legal")}</a>
        )}
        {lang === "fr" && (
          <a class="site-chrome-footer__link" href="/politique-de-confidentialite/">
            {t("footer.privacy")}
          </a>
        )}
        <a
          class="site-chrome-footer__link"
          href="https://www.linkedin.com/company/izybiz/"
          data-linkedin
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a class="site-chrome-footer__link" href={contactHref}>Contact</a>
        <div class="site-chrome-footer__copyright">{t("footer.copyright")}</div>
      </div>
    </footer>
    <script is:inline>
      // Menu mobile du header. Volontairement autonome (et non dans script.js,
      // qui n'est chargé que sur certaines pages) pour fonctionner partout.
      (function () {
        var toggle = document.querySelector("[data-chrome-toggle]");
        var menu = document.querySelector("[data-chrome-menu]");
        if (!toggle || !menu) return;

        function setOpen(open) {
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
          menu.hidden = !open;
        }

        toggle.addEventListener("click", function () {
          setOpen(menu.hidden);
        });

        menu.addEventListener("click", function (event) {
          if (event.target.closest("a")) setOpen(false);
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Repasser en desktop doit refermer le panneau, sinon il reste ouvert
        // au retour en mobile.
        window.matchMedia("(min-width: 861px)").addEventListener("change", function (e) {
          if (e.matches) setOpen(false);
        });
      })();
    </script>
    <script is:inline>
      window.__IZYBIZ_LANG = "{lang}";
      window.__IZYBIZ_DEFAULT_LANG = "{defaultLang}";
    </script>
    {includeGlobalScript ? <script is:inline src="/script.js"></script> : null}
    <script is:inline src="/analytics.js"></script>
    <CookieConsent lang={lang} />
  </body>
</html>
