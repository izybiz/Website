---
import "../styles/blog.css";
import "../styles/site-chrome.css";
import { t, type Lang } from "../data/ui-strings";
import { counterpartPath } from "../data/i18n-routes";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  ogImage?: string;
  pubDate?: string;
  noindex?: boolean;
  lang?: Lang;
}

const frontmatter = (Astro.props as { frontmatter?: Partial<Props> }).frontmatter ?? {};

const {
  title = frontmatter.title ?? "Izybiz",
  description = frontmatter.description ?? "",
  canonicalPath = frontmatter.canonicalPath ?? Astro.url.pathname,
  ogType = frontmatter.ogType ?? "website",
  ogImage = frontmatter.ogImage ?? "https://izybiz.fr/assets/og-default.jpg",
  pubDate = frontmatter.pubDate,
  noindex = frontmatter.noindex ?? false,
  lang = frontmatter.lang ?? "fr",
} = Astro.props as Partial<Props>;

const isBlogArticlePage = /^\/(en\/)?blog\/[^/]+\/?$/.test(Astro.url.pathname);
const rawPath = canonicalPath || "/";
const canonicalUrl = `https://izybiz.fr${rawPath.endsWith("/") ? rawPath : rawPath + "/"}`;

// Paire FR/EN de la page courante, pour les balises hreflang et le bouton du
// header : voir src/data/i18n-routes.ts, source unique du mapping.
const counterpart = counterpartPath(rawPath);
const frHref = lang === "fr" ? canonicalUrl : counterpart ? `https://izybiz.fr${counterpart.fr}` : null;
const enHref = lang === "en" ? canonicalUrl : counterpart ? `https://izybiz.fr${counterpart.en}` : null;
// Le français reste la langue par défaut du site.
const xDefaultHref = frHref ?? canonicalUrl;
const otherLangPath = lang === "fr" ? (counterpart ? counterpart.en : "/en/") : (counterpart ? counterpart.fr : "/");

// La home v2 remplace la section #prendre-contact par le formulaire de
// diagnostic : le CTA du header pointe dessus, depuis n'importe quelle page.
const diagnosticHref = lang === "en" ? "/en/#diagnostic" : "/#diagnostic";
const legalHref = lang === "en" ? "/en/legal-notice/" : "/mentions-legales/";
const privacyHref = lang === "en" ? "/en/privacy-policy/" : "/politique-de-confidentialite/";
const contactHref = lang === "en" ? "/en/contact/" : "/contact/";
const blogHref = lang === "en" ? "/en/blog/" : "/blog/";
const homeHref = lang === "en" ? "/en/" : "/";

// Textes traduits du JSON-LD Organization/SoftwareApplication : voir le
// piège « données structurées » dans CLAUDE.md — à relire à chaque
// changement de positionnement, dans les deux langues.
const jsonLdCopy = {
  fr: {
    orgDescription:
      "Izybiz édite Izy, un logiciel d'agents IA qui exécute la visibilité en ligne des PME et ETI B2B en France : diagnostic, audit et optimisation du site, calendrier éditorial, articles et posts, veille de marché, bilan mensuel.",
    appDescription:
      "Izy fait venir les clients aux PME et ETI B2B : il audite et corrige le site, construit la stratégie et le calendrier éditorial, rédige articles et posts, surveille le marché et mesure la visibilité chaque mois.",
    offerName: "Diagnostic de visibilité",
    offerDescription:
      "Diagnostic automatisé de votre visibilité en ligne, en cinq minutes, sans engagement.",
  },
  en: {
    orgDescription:
      "Izybiz publishes Izy, an AI agent software that runs online visibility for French B2B SMEs and mid-sized companies: diagnosis, site audit and optimisation, editorial calendar, articles and posts, market monitoring, monthly reporting.",
    appDescription:
      "Izy brings customers to B2B SMEs and mid-sized companies: it audits and fixes the site, builds the strategy and editorial calendar, writes articles and posts, monitors the market and measures visibility every month.",
    offerName: "Visibility diagnosis",
    offerDescription:
      "Automated diagnosis of your online visibility, in five minutes, no commitment.",
  },
} as const;
const ld = jsonLdCopy[lang];
const siteRoot = lang === "en" ? "https://izybiz.fr/en" : "https://izybiz.fr";
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TS3MZTN79V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // Consent Mode v2: deny by default before analytics storage is granted.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        wait_for_update: 500
      });
      // Restore previous consent if user already chose.
      try {
        if (localStorage.getItem('cookie_consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
      gtag('config', 'G-TS3MZTN79V');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="icon" href="/assets/fav-icon.png" type="image/png" />

    <link rel="canonical" href={canonicalUrl} />
    {frHref && <link rel="alternate" hreflang="fr" href={frHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!--
      Données structurées : Organization + SoftwareApplication, sur toutes les
      pages. C'est ce que Google et les moteurs de réponse IA lisent en priorité
      pour décrire l'offre — chaque affirmation doit donc correspondre à ce que
      la home dit vraiment. Vérifié le 2026-08-13 :
      le diagnostic est gratuit et ouvert à tous (l'ancien « accès sur
      invitation » était devenu faux), et le site est monolingue.
    -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://izybiz.fr/#organization",
          "name": "Izybiz",
          "url": "https://izybiz.fr/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://izybiz.fr/assets/Logo%20Izybiz.png"
          },
          "description": ld.orgDescription,
          "email": "contact.me@izybiz.fr",
          "foundingDate": "2025",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "361 rue Lecourbe",
            "postalCode": "75015",
            "addressLocality": "Paris",
            "addressCountry": "FR"
          },
          "areaServed": {
            "@type": "Country",
            "name": "France"
          },
          "sameAs": [
            "https://www.linkedin.com/company/izybiz/"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "sales",
            "email": "contact.me@izybiz.fr",
            "url": `${siteRoot}/contact/`,
            "availableLanguage": ["French", "English"]
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://izybiz.fr/#software",
          "name": "Izy",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "url": "https://izybiz.fr/",
          "description": ld.appDescription,
          // Seule offre chiffrable publiquement : le diagnostic, gratuit. Le
          // cadrage et l'abonnement mensuel sont établis après le diagnostic,
          // selon la mission — aucun montant n'est annoncé sur le site, on n'en
          // invente donc pas ici.
          "offers": {
            "@type": "Offer",
            "name": ld.offerName,
            "description": ld.offerDescription,
            "price": "0",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/InStock",
            "url": `${siteRoot}/#diagnostic`
          },
          "provider": {
            "@id": "https://izybiz.fr/#organization"
          }
        }
      ]
    })} />

    {ogType === "article" && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "url": canonicalUrl,
        ...(pubDate && { "datePublished": pubDate, "dateModified": pubDate }),
        "image": ogImage,
        "author": {
          "@type": "Person",
          "name": "Stéphane Dine",
          "url": "https://www.linkedin.com/company/izybiz/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Izybiz",
          "logo": {
            "@type": "ImageObject",
            "url": "https://izybiz.fr/assets/Logo%20Izybiz.png"
          }
        }
      })} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    {lang === "fr" && enHref && <meta property="og:locale:alternate" content="en_US" />}
    {lang === "en" && frHref && <meta property="og:locale:alternate" content="fr_FR" />}
    <meta property="og:site_name" content="Izybiz" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body id="top" class:list={[isBlogArticlePage && "page-blog-article"]}>
    <header class="site-chrome" aria-label="Site header">
      <div class="site-chrome__inner">
        <a class="site-chrome__brand" href={homeHref} aria-label={lang === "en" ? "Izybiz home" : "Accueil Izybiz"}>
          <img
            class="site-chrome__logo"
            src="/assets/logo-izybiz.svg"
            alt="IZYBIZ"
            width="710"
            height="198"
            fetchpriority="high"
          />
        </a>
        <div class="site-chrome__spacer"></div>

        <nav class="site-chrome__nav" aria-label="Primary">
          <a class="site-chrome__link" href={blogHref}>{t("nav.blog", lang)}</a>
          {/* Sans destination tant que l'app n'a pas d'URL publique — rendu en
              <span> pour éviter un lien mort qui renverrait en haut de page. */}
          <span class="site-chrome__link site-chrome__link--inactive">{t("nav.login", lang)}</span>
          <a
            class="site-chrome__link site-chrome__lang"
            href={otherLangPath}
            aria-label={lang === "fr" ? "Switch to English" : "Passer en français"}
            hreflang={lang === "fr" ? "en" : "fr"}
          >
            {lang === "fr" ? "EN" : "FR"}
          </a>
          <a class="site-chrome__cta" href={diagnosticHref} data-cta="header">{t("nav.cta", lang)}</a>
        </nav>

        <button
          class="site-chrome__toggle"
          type="button"
          aria-label={lang === "en" ? "Open menu" : "Ouvrir le menu"}
          aria-controls="site-chrome-menu"
          aria-expanded="false"
          data-chrome-toggle
          data-open-label={lang === "en" ? "Open menu" : "Ouvrir le menu"}
          data-close-label={lang === "en" ? "Close menu" : "Fermer le menu"}
        >
          <span class="site-chrome__toggle-bar" aria-hidden="true"></span>
        </button>
      </div>

      <div class="site-chrome__menu" id="site-chrome-menu" hidden data-chrome-menu>
        <a class="site-chrome__menu-link" href={blogHref}>{t("nav.blog", lang)}</a>
        <span class="site-chrome__menu-link site-chrome__link--inactive">{t("nav.login", lang)}</span>
        <a
          class="site-chrome__menu-link"
          href={otherLangPath}
          aria-label={lang === "fr" ? "Switch to English" : "Passer en français"}
          hreflang={lang === "fr" ? "en" : "fr"}
        >
          {lang === "fr" ? "EN" : "FR"}
        </a>
      </div>
    </header>
    <div class="layout-content-slot">
      <slot />
    </div>
    <footer class="site-chrome-footer" aria-label="Footer" data-section="footer">
      <div class="site-chrome-footer__inner">
        <a href={homeHref} aria-label={lang === "en" ? "Izybiz home" : "Accueil Izybiz"}>
          <img
            class="site-chrome-footer__logo"
            src="/assets/logo-izybiz.svg"
            alt="IZYBIZ"
            width="710"
            height="198"
          />
        </a>
        <a class="site-chrome-footer__link" href={legalHref}>{t("footer.legal", lang)}</a>
        <a class="site-chrome-footer__link" href={privacyHref}>
          {t("footer.privacy", lang)}
        </a>
        <a
          class="site-chrome-footer__link"
          href="https://www.linkedin.com/company/izybiz/"
          data-linkedin
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a class="site-chrome-footer__link" href={contactHref}>{t("footer.contact", lang)}</a>
        <div class="site-chrome-footer__copyright">{t("footer.copyright", lang)}</div>
      </div>
    </footer>
    <script is:inline>
      // Menu mobile du header. Volontairement inline plutôt que dans un fichier
      // de /public : le chrome est sur toutes les pages, le script aussi.
      (function () {
        var toggle = document.querySelector("[data-chrome-toggle]");
        var menu = document.querySelector("[data-chrome-menu]");
        if (!toggle || !menu) return;

        function setOpen(open) {
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.setAttribute(
            "aria-label",
            open ? toggle.dataset.closeLabel : toggle.dataset.openLabel,
          );
          menu.hidden = !open;
        }

        toggle.addEventListener("click", function () {
          setOpen(menu.hidden);
        });

        menu.addEventListener("click", function (event) {
          if (event.target.closest("a")) setOpen(false);
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Repasser en desktop doit refermer le panneau, sinon il reste ouvert
        // au retour en mobile.
        window.matchMedia("(min-width: 861px)").addEventListener("change", function (e) {
          if (e.matches) setOpen(false);
        });
      })();
    </script>
    <script is:inline src="/analytics.js"></script>
    <CookieConsent lang={lang} />
  </body>
</html>
