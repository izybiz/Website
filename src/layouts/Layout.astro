---
import "../styles/blog.css";
import "../styles/site-chrome.css";
import { t, type Lang } from "../data/ui-strings";
import { counterpartPath } from "../data/i18n-routes";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  ogImage?: string;
  pubDate?: string;
  /** Auteur de l'article (JSON-LD). Sans valeur, fallback historique ci-dessous. */
  author?: { name: string; url?: string };
  noindex?: boolean;
  lang?: Lang;
}

const frontmatter = (Astro.props as { frontmatter?: Partial<Props> }).frontmatter ?? {};

const {
  title = frontmatter.title ?? "Izybiz",
  description = frontmatter.description ?? "",
  canonicalPath = frontmatter.canonicalPath ?? Astro.url.pathname,
  ogType = frontmatter.ogType ?? "website",
  ogImage = frontmatter.ogImage ?? "https://izybiz.fr/assets/og-default.jpg",
  pubDate = frontmatter.pubDate,
  author,
  noindex = frontmatter.noindex ?? false,
  lang = frontmatter.lang ?? "fr",
} = Astro.props as Partial<Props>;

const isBlogArticlePage = /^\/(en\/)?blog\/[^/]+\/?$/.test(Astro.url.pathname);
const rawPath = canonicalPath || "/";
const canonicalUrl = `https://izybiz.fr${rawPath.endsWith("/") ? rawPath : rawPath + "/"}`;

// Paire FR/EN de la page courante, pour les balises hreflang et le bouton du
// header : voir src/data/i18n-routes.ts, source unique du mapping.
const counterpart = counterpartPath(rawPath);
const frHref = lang === "fr" ? canonicalUrl : counterpart ? `https://izybiz.fr${counterpart.fr}` : null;
const enHref = lang === "en" ? canonicalUrl : counterpart ? `https://izybiz.fr${counterpart.en}` : null;
// Le français reste la langue par défaut du site.
const xDefaultHref = frHref ?? canonicalUrl;
const otherLangPath = lang === "fr" ? (counterpart ? counterpart.en : "/en/") : (counterpart ? counterpart.fr : "/");

const legalHref = lang === "en" ? "/en/legal-notice/" : "/mentions-legales/";
const privacyHref = lang === "en" ? "/en/privacy-policy/" : "/politique-de-confidentialite/";
const contactHref = lang === "en" ? "/en/contact/" : "/contact/";
const blogHref = lang === "en" ? "/en/blog/" : "/blog/";
const homeHref = lang === "en" ? "/en/" : "/";
const aboutHref = lang === "en" ? "/en/about/" : "/a-propos/";
const servicesHref = lang === "en" ? "/en/services/" : "/services/";

// Textes traduits du JSON-LD Organization : voir le
// piège « données structurées » dans CLAUDE.md — à relire à chaque
// changement de positionnement, dans les deux langues.
const jsonLdCopy = {
  fr: {
    orgDescription:
      "Izybiz accompagne les ETI et scale-ups en management de transition et en intégration IA : reprendre la main sur les opérations, fixer les priorités, tenir l'exécution et déployer l'IA jusqu'à des résultats mesurables.",
    services: [
      { name: "Management de transition", path: "/management-de-transition/" },
      { name: "Intégration IA en entreprise", path: "/integration-ia/" },
    ],
  },
  en: {
    orgDescription:
      "Izybiz supports mid-market companies and scale-ups with interim management and AI integration: taking back control of operations, setting priorities, driving execution and deploying AI through to measurable results.",
    services: [
      { name: "Interim Management", path: "/en/interim-management/" },
      { name: "AI Integration in Business", path: "/en/ai-integration/" },
    ],
  },
} as const;
const ld = jsonLdCopy[lang];
const siteRoot = lang === "en" ? "https://izybiz.fr/en" : "https://izybiz.fr";
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TS3MZTN79V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // Consent Mode v2: deny by default before analytics storage is granted.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        wait_for_update: 500
      });
      // Restore previous consent if user already chose.
      try {
        if (localStorage.getItem('cookie_consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
      // Trafic interne (équipe izybiz) : ouvrir une fois /?interne=1 marque ce
      // navigateur, /?interne=0 retire la marque. Les visites marquées partent
      // avec traffic_type=internal et sont exclues des rapports par le filtre
      // « Internal Traffic » de GA4 (à activer dans Admin → Filtres de données).
      var interne = false;
      try {
        var flag = new URLSearchParams(location.search).get('interne');
        if (flag === '1') localStorage.setItem('izybiz_interne', '1');
        else if (flag === '0') localStorage.removeItem('izybiz_interne');
        interne = localStorage.getItem('izybiz_interne') === '1';
      } catch (e) {}
      gtag('config', 'G-TS3MZTN79V', interne ? { traffic_type: 'internal' } : {});
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Didact+Gothic&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="icon" href="/assets/fav-icon.png" type="image/png" />

    <link rel="canonical" href={canonicalUrl} />
    {frHref && <link rel="alternate" hreflang="fr" href={frHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!--
      Données structurées : Organization, sur toutes les
      pages. C'est ce que Google et les moteurs de réponse IA lisent en priorité
      pour décrire l'offre — chaque affirmation doit donc correspondre à ce que
      la home dit vraiment. Revu le 2026-09-26 : positionnement management de
      transition + intégration IA. Le logiciel Izy et son diagnostic gratuit
      ne sont plus promus (page /diagnostic-visibilite/ en noindex), leur
      bloc SoftwareApplication a donc été retiré.
    -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://izybiz.fr/#organization",
          "name": "Izybiz",
          "url": "https://izybiz.fr/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://izybiz.fr/assets/Logo%20Izybiz.png"
          },
          "description": ld.orgDescription,
          "email": "contact.me@izybiz.fr",
          "foundingDate": "2025",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "361 rue Lecourbe",
            "postalCode": "75015",
            "addressLocality": "Paris",
            "addressCountry": "FR"
          },
          "areaServed": {
            "@type": "Country",
            "name": "France"
          },
          "sameAs": [
            "https://www.linkedin.com/company/izybiz/"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "sales",
            "email": "contact.me@izybiz.fr",
            "url": `${siteRoot}/contact/`,
            "availableLanguage": ["French", "English"]
          },
          // Les deux offres ; le détail de chacune est dans le schéma Service
          // de sa page dédiée.
          "makesOffer": ld.services.map((service) => ({
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": service.name,
              "url": `https://izybiz.fr${service.path}`
            }
          }))
        }
      ]
    })} />

    {ogType === "article" && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "url": canonicalUrl,
        ...(pubDate && { "datePublished": pubDate, "dateModified": pubDate }),
        "image": ogImage,
        "author": {
          "@type": "Person",
          "name": author?.name ?? "Stéphane Dine",
          "url": author?.url ?? "https://www.linkedin.com/company/izybiz/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Izybiz",
          "logo": {
            "@type": "ImageObject",
            "url": "https://izybiz.fr/assets/Logo%20Izybiz.png"
          }
        }
      })} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    {lang === "fr" && enHref && <meta property="og:locale:alternate" content="en_US" />}
    {lang === "en" && frHref && <meta property="og:locale:alternate" content="fr_FR" />}
    <meta property="og:site_name" content="Izybiz" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body id="top" class:list={[isBlogArticlePage && "page-blog-article"]}>
    <header class="site-chrome" aria-label="Site header">
      <div class="site-chrome__inner">
        <a class="site-chrome__brand" href={homeHref} aria-label={lang === "en" ? "Izybiz home" : "Accueil Izybiz"}>
          <img
            class="site-chrome__logo"
            src="/assets/logo-izybiz.svg"
            alt="IZYBIZ"
            width="710"
            height="198"
            fetchpriority="high"
          />
        </a>
        <div class="site-chrome__spacer"></div>

        <nav class="site-chrome__nav" aria-label="Primary">
          <a class="site-chrome__link" href={aboutHref}>{t("nav.about", lang)}</a>
          <a class="site-chrome__link" href={servicesHref}>{t("nav.services", lang)}</a>
          <a class="site-chrome__link" href={blogHref}>{t("nav.blog", lang)}</a>
          <a
            class="site-chrome__link site-chrome__lang"
            href={otherLangPath}
            aria-label={lang === "fr" ? "Switch to English" : "Passer en français"}
            hreflang={lang === "fr" ? "en" : "fr"}
          >
            {lang === "fr" ? "EN" : "FR"}
          </a>
        </nav>

        <button
          class="site-chrome__toggle"
          type="button"
          aria-label={lang === "en" ? "Open menu" : "Ouvrir le menu"}
          aria-controls="site-chrome-menu"
          aria-expanded="false"
          data-chrome-toggle
          data-open-label={lang === "en" ? "Open menu" : "Ouvrir le menu"}
          data-close-label={lang === "en" ? "Close menu" : "Fermer le menu"}
        >
          <span class="site-chrome__toggle-bar" aria-hidden="true"></span>
        </button>
      </div>

      <div class="site-chrome__menu" id="site-chrome-menu" hidden data-chrome-menu>
        <a class="site-chrome__menu-link" href={aboutHref}>{t("nav.about", lang)}</a>
        <a class="site-chrome__menu-link" href={servicesHref}>{t("nav.services", lang)}</a>
        <a class="site-chrome__menu-link" href={blogHref}>{t("nav.blog", lang)}</a>
        <a
          class="site-chrome__menu-link"
          href={otherLangPath}
          aria-label={lang === "fr" ? "Switch to English" : "Passer en français"}
          hreflang={lang === "fr" ? "en" : "fr"}
        >
          {lang === "fr" ? "EN" : "FR"}
        </a>
      </div>
    </header>
    <div class="layout-content-slot">
      <slot />
    </div>
    <footer class="site-chrome-footer" aria-label="Footer" data-section="footer">
      <div class="site-chrome-footer__inner">
        <a href={homeHref} aria-label={lang === "en" ? "Izybiz home" : "Accueil Izybiz"}>
          <img
            class="site-chrome-footer__logo"
            src="/assets/logo-izybiz.svg"
            alt="IZYBIZ"
            width="710"
            height="198"
          />
        </a>
        <a class="site-chrome-footer__link" href={legalHref}>{t("footer.legal", lang)}</a>
        <a class="site-chrome-footer__link" href={privacyHref}>
          {t("footer.privacy", lang)}
        </a>
        <a
          class="site-chrome-footer__link"
          href="https://www.linkedin.com/company/izybiz/"
          data-linkedin
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a class="site-chrome-footer__link" href={contactHref} data-cta="footer">{t("footer.contact", lang)}</a>
        <div class="site-chrome-footer__copyright">{t("footer.copyright", lang)}</div>
      </div>
    </footer>
    <script is:inline>
      // Menu mobile du header. Volontairement inline plutôt que dans un fichier
      // de /public : le chrome est sur toutes les pages, le script aussi.
      (function () {
        var toggle = document.querySelector("[data-chrome-toggle]");
        var menu = document.querySelector("[data-chrome-menu]");
        if (!toggle || !menu) return;

        function setOpen(open) {
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.setAttribute(
            "aria-label",
            open ? toggle.dataset.closeLabel : toggle.dataset.openLabel,
          );
          menu.hidden = !open;
        }

        toggle.addEventListener("click", function () {
          setOpen(menu.hidden);
        });

        menu.addEventListener("click", function (event) {
          if (event.target.closest("a")) setOpen(false);
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Repasser en desktop doit refermer le panneau, sinon il reste ouvert
        // au retour en mobile.
        window.matchMedia("(min-width: 861px)").addEventListener("change", function (e) {
          if (e.matches) setOpen(false);
        });
      })();
    </script>
    <script is:inline src="/analytics.js"></script>
    <CookieConsent lang={lang} />
  </body>
</html>
